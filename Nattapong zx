--// SETTINGS
local defaultSpeed = 16
local minSpeed = 16
local maxSpeed = 200
local step = 5

local player = game.Players.LocalPlayer

--// GUI
local gui = Instance.new("ScreenGui")
gui.Name = "SpeedGui"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0,180,0,130)
frame.Position = UDim2.new(0,20,0.5,-65)
frame.BackgroundColor3 = Color3.fromRGB(25,25,25)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true

-- ปุ่มเปิด/ปิด GUI
local openBtn = Instance.new("TextButton", gui)
openBtn.Size = UDim2.new(0,60,0,25)
openBtn.Position = UDim2.new(0,20,0.5,70)
openBtn.Text = "OPEN"

-- Title
local title = Instance.new("TextLabel", frame)
title.Size = UDim2.new(1,0,0,25)
title.Text = "Speed"
title.BackgroundTransparency = 1
title.TextColor3 = Color3.new(1,1,1)

-- Toggle Speed
local toggleBtn = Instance.new("TextButton", frame)
toggleBtn.Size = UDim2.new(1,-20,0,25)
toggleBtn.Position = UDim2.new(0,10,0,30)
toggleBtn.Text = "OFF"

-- Speed Text
local speedLabel = Instance.new("TextLabel", frame)
speedLabel.Size = UDim2.new(1,0,0,20)
speedLabel.Position = UDim2.new(0,0,0,60)
speedLabel.Text = "Speed: "..defaultSpeed
speedLabel.BackgroundTransparency = 1
speedLabel.TextColor3 = Color3.new(1,1,1)

-- + ปุ่ม
local addBtn = Instance.new("TextButton", frame)
addBtn.Size = UDim2.new(0.5,-15,0,25)
addBtn.Position = UDim2.new(0,10,0,90)
addBtn.Text = "+"

-- - ปุ่ม
local subBtn = Instance.new("TextButton", frame)
subBtn.Size = UDim2.new(0.5,-15,0,25)
subBtn.Position = UDim2.new(0.5,5,0,90)
subBtn.Text = "-"

--// LOGIC
local speed = defaultSpeed
local enabled = false

local function getHumanoid()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("Humanoid")
end

-- เปิด/ปิด Speed
toggleBtn.MouseButton1Click:Connect(function()
    enabled = not enabled
    local hum = getHumanoid()
    
    if enabled then
        hum.WalkSpeed = speed
        toggleBtn.Text = "ON"
    else
        hum.WalkSpeed = defaultSpeed
        toggleBtn.Text = "OFF"
    end
end)

-- เพิ่มสปีด
addBtn.MouseButton1Click:Connect(function()
    speed = math.clamp(speed + step, minSpeed, maxSpeed)
    speedLabel.Text = "Speed: "..speed
    
    if enabled then
        getHumanoid().WalkSpeed = speed
    end
end)

-- ลดสปีด
subBtn.MouseButton1Click:Connect(function()
    speed = math.clamp(speed - step, minSpeed, maxSpeed)
    speedLabel.Text = "Speed: "..speed
    
    if enabled then
        getHumanoid().WalkSpeed = speed
    end
end)

-- ปุ่มเปิด/ปิด GUI
local guiOpen = true
openBtn.MouseButton1Click:Connect(function()
    guiOpen = not guiOpen
    frame.Visible = guiOpen
    
    if guiOpen then
        openBtn.Text = "CLOSE"
    else
        openBtn.Text = "OPEN"
    end
end)

-- กันรีเซ็ต
player.CharacterAdded:Connect(function()
    if enabled then
        getHumanoid().WalkSpeed = speed
    end
end)
